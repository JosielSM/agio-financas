{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agio-financas",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/main",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_KIND": "main",
    "APP_ORIGIN": "https://agio-financas.santosjosiel2003.workers.dev",
    "MERCADO_PAGO_ENV": "production",
    "SUPABASE_URL": "https://umnmabuvldkfopfyzwbw.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_R7DrN0yYGXWas1x0oNt1sQ_umbK685G"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
